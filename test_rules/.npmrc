# Pin the public registry for this package.
#
# Without this, a contributor whose global npm config points at a private
# registry (a corporate Artifactory, say) bakes that host into every `resolved`
# URL in package-lock.json — and CI, which has no credentials for it, fails
# `npm ci` with an authentication error. It also leaks an internal hostname into
# a public repo.
registry=https://registry.npmjs.org/

# The lockfile is committed and `npm ci` depends on it; keep it exact.
save-exact=false
