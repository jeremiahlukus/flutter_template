**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Security-rules test package (Node).
#
# `package-lock.json` IS committed: the rules job runs `npm ci`, which requires a
# lockfile and fails without one. It is also what makes that install
# reproducible, which is the point of using `ci` over `install`.
test_rules/node_modules/

# Firebase emulator artefacts
firebase-debug.*.log
firestore-debug.log
ui-debug.log

# Golden failure diffs are generated on a failed comparison.
test/goldens/failures/

# gen-l10n's untranslated-message report. Regenerated on every `pub get`, and
# CI asserts it is empty — a tracked file that is always `{}` is just noise.
lib/src/l10n/untranslated.json
